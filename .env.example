# Copy to .env (gitignored). Placeholders only; never commit real secrets.
# URL-safe characters only in the password (it is embedded in DATABASE_URL by compose and `make run`).
POSTGRES_PASSWORD=
API_PORT=8080

APP_ENV=development
WORKSPACE_NAME=Our Collection
LOG_LEVEL=info
LOG_FORMAT=json

# Optional lookup settings (secrets stay blank here). Read by the dev and test stacks (./deploy/dev, ./deploy/test).
# TMDB API key for movie and TV lookup (server side only). Empty disables it.
TMDB_API_KEY=
# Book lookup uses Open Library: always on, no key needed. Optional contact e-mail sent in the User-Agent (raises its rate limit from 1 to 3 requests/second).
OPENLIBRARY_CONTACT=

# Used only by `make run` (host loop, needs compose.override.yaml). Compose sets its own values for the api container.
# DATABASE_URL is built from POSTGRES_PASSWORD by `make run`; set it here only to override.
HTTP_ADDR=:8080
DB_MAX_CONNS=10
DATA_DIR=./data
