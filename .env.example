# Copy to .env (gitignored). Placeholders only; never commit real secrets.
# URL-safe characters only in the password (it is embedded in DATABASE_URL by compose and `make run`).
POSTGRES_PASSWORD=
API_PORT=8080

APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# Identity (F-027). Production (APP_ENV=production) needs ACCESS_TEAM_DOMAIN + ACCESS_AUD + OWNER_EMAIL and refuses DEV_IDENTITY=true.
# Cloudflare Access team domain (e.g. myteam.cloudflareaccess.com) and the Access application's audience tag.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# E-mail of the owner (lower-cased). Requests from the home network (no Cloudflare edge header, no token)
# always act as this user (D-150); with DEV_IDENTITY=true it is the first dev identity instead.
OWNER_EMAIL=
# Dev/test only: fake users (owner, alice@dev.test, bob@dev.test) chosen with X-Dev-User / the dev_user cookie.
DEV_IDENTITY=true

# Optional lookup settings (secrets stay blank here). Read by the dev and test stacks (./deploy/dev, ./deploy/test).
# TMDB API key for movie and TV lookup (server side only). Empty disables it.
TMDB_API_KEY=
# Book lookup uses Open Library: always on, no key needed. Optional contact e-mail sent in the User-Agent (raises its rate limit from 1 to 3 requests/second).
OPENLIBRARY_CONTACT=
# Optional Hardcover token (server side only): fills the author and page count Open Library lacks, and covers books it does not know, in the automatic book lookup. Empty disables it. The token expires, so renew it when lookups stop filling gaps.
HARDCOVER_API_KEY=

# Used only by `make run` (host loop, needs compose.override.yaml). Compose sets its own values for the api container.
# DATABASE_URL is built from POSTGRES_PASSWORD by `make run`; set it here only to override.
HTTP_ADDR=:8080
DB_MAX_CONNS=10
DATA_DIR=./data
